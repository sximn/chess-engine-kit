{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "bin/**/*.ts",
    "tests/*.ts",
    "tests/browser/**/*.ts",
    "tests/integration/browser-app/offline.ts",
    "playwright.config.ts"
  ]
}
