{
  "name": "chess-engine-kit",
  "version": "0.0.1",
  "description": "Engine-neutral browser chess analysis API with a prebuilt Frozenight WASM adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sximn/chess-engine-kit.git"
  },
  "homepage": "https://github.com/sximn/chess-engine-kit#readme",
  "bugs": {
    "url": "https://github.com/sximn/chess-engine-kit/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "chess-engine-assets": "./dist/bin/copy-assets.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/",
    "examples/minimal/README.md",
    "examples/minimal/package.json",
    "examples/minimal/package-lock.json",
    "examples/minimal/tsconfig.json",
    "examples/minimal/vite.config.ts",
    "examples/minimal/index.html",
    "examples/minimal/src/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "check": "bun check",
    "test": "bun scripts/test.ts",
    "test:browser": "playwright test",
    "test:package": "bun scripts/verification/verify-package.ts",
    "test:versioning": "bun scripts/verification/verify-versioning.ts",
    "engine:build": "bun scripts/maintenance/engine/build-engine.ts",
    "engine:reference": "bun scripts/maintenance/engine/build-reference.ts",
    "engine:notices": "bun scripts/maintenance/engine/engine-notices.ts",
    "engine:verify": "bun scripts/maintenance/engine/verify-reproducibility.ts",
    "test:native": "bun scripts/maintenance/engine/verify-native.ts",
    "example:setup": "bun scripts/setup-example.ts",
    "release:prepare": "bun scripts/release/prepare-release.ts",
    "release:check": "bun scripts/release/check-release.ts",
    "release:dry-run": "bun scripts/release/publish.ts --dry-run",
    "release:publish": "bun scripts/release/publish.ts",
    "version:patch": "bun pm version patch --no-git-tag-version",
    "version:minor": "bun pm version minor --no-git-tag-version",
    "version:major": "bun pm version major --no-git-tag-version",
    "prepack": "bun run build"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "24.10.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "chess",
    "wasm",
    "chess-engine",
    "browser",
    "typescript"
  ]
}
